# 운영 환경 비밀값 예시 파일. 실제 값을 채운 뒤 backend/.env 로 복사한다.
# Spring Boot 가 부팅 시 자동으로 properties 형식으로 읽어들인다 (optional).

# 학습 종합 피드백 단계에서 호출할 LLM 키. 비워 두면 규칙 기반 fallback 으로 동작한다.
LLM_API_KEY=
LLM_PROVIDER=rule-based
LLM_MODEL=gemini-1.5-flash

# JWT 발급 비밀키 (HS256). 32바이트 이상 권장.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRE_MS=86400000

# 모델 서버 (FastAPI) 주소.
MODEL_SERVER_BASE_URL=http://localhost:8001
MODEL_SERVER_TIMEOUT_MS=30000

# 점수 공식 가중치. 1 - alpha 만큼 모델 confidence 가 반영된다.
SCORING_ALPHA=0.7

# 녹음 파일 저장 디렉토리.
RECORDING_DIR=./backend-storage/recordings
