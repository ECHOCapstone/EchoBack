# ===== 로컬 개발용 환경 변수 템플릿 =====
# 사용법: `cp .env.example .env.local` 후 실제 값을 채우고 `source .env.local` 한다.
# .env.local 은 .gitignore 에 들어있어 커밋되지 않는다. 이 파일에 실키를 적지 말 것.
# (Spring Boot 가 자동으로 읽지는 않는다 — 쉘 export 후 ./gradlew bootRun 으로 실행.)

# Gemini API key. https://aistudio.google.com/app/apikey 에서 발급.
# APP_LLM_PROVIDER=gemini 일 때만 사용된다.
export GEMINI_API_KEY=''

# LLM provider. rule-based (외부 호출 없음, 기본) | gemini (Gemini 호출)
export APP_LLM_PROVIDER=rule-based

# 선택: Gemini 모델 ID 오버라이드. application.yaml 기본값은 gemini-2.5-flash.
# export APP_LLM_GEMINI_MODEL=gemini-2.5-flash

# ===== Google OAuth2 로그인 =====
# Google Cloud Console > APIs & Services > Credentials 에서 OAuth 2.0 Client ID 발급.
# Authorized redirect URI 에 http://localhost:8080/login/oauth2/code/google 등록 필요.
export GOOGLE_CLIENT_ID=''
export GOOGLE_CLIENT_SECRET=''

# ===== Kakao OIDC 로그인 =====
# Kakao Developers 콘솔 > 내 애플리케이션 > 앱 설정 > 앱 키 의 "REST API 키" 와
# 보안 > Client Secret 의 활성화된 시크릿을 사용한다.
# 필수 콘솔 설정:
#   1. 카카오 로그인 > 활성화 ON, OpenID Connect 활성화 ON
#   2. Redirect URI 에 http://localhost:5173/api/auth/oauth2/kakao/callback 등록
#   3. 동의 항목 profile_nickname, account_email 활성화
export KAKAO_REST_API_KEY=''
export KAKAO_CLIENT_SECRET=''

# OAuth2 로그인 성공 후 JWT 를 fragment 로 실어 redirect 할 프론트엔드 URL.
# 미설정 시 application.yaml 기본값 (http://localhost:3000/oauth/callback) 이 쓰인다.
# export APP_OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth/callback

# OAuth2 로그인 실패 시 redirect 할 프론트엔드 URL (?oauthError=<code> 쿼리가 붙음).
# export APP_OAUTH2_FRONTEND_ERROR_URI=http://localhost:3000/login

# ===== JWT =====
# app.jwt.secret 으로 바인딩되는 JWT 서명 키 (HS256, 최소 32바이트).
# 예: `openssl rand -base64 48` 로 생성. 실키는 이 파일에 적지 말 것.
export APP_JWT_SECRET=''

# ===== 관리자 =====
# 이 username 계정을 부팅 시 관리자(ROLE_ADMIN)로 승격한다 (로그인에 쓰는 username).
# 비워 두면 승격하지 않으며, /admin 관리자 페이지에 접근할 수 없다.
export APP_ADMIN_BOOTSTRAP_USERNAME=''

# 시드 관리자 계정 — 시연/평가 등에서 가입 절차 없이 즉시 admin 로그인을 줄 때 사용한다.
# 네 항목이 모두 채워지면 부팅 시 자동으로 만들어진다 (멱등). 비밀번호는 BCrypt 로 해시되어 저장된다.
# 운영에선 시연 후 평문 비밀번호를 .env.local 에서 지우고 admin 페이지에서 비밀번호를 바꾸는 것을 권장한다.
export APP_ADMIN_SEED_USERNAME=''
export APP_ADMIN_SEED_EMAIL=''
export APP_ADMIN_SEED_PASSWORD=''
export APP_ADMIN_SEED_NICKNAME='관리자'

# ===== MySQL =====
# Spring Boot 가 application.yaml 의 ${DB_URL:...} 으로 바인딩. 비워 두면 dev 디폴트(localhost:3306/echo) 사용.
# 운영에선 절대 비워 두지 말 것.
# 로컬 셋업: mysql 8.0 + 데이터베이스 echo + 사용자 echo (CREATE DATABASE / CREATE USER / GRANT 후 사용).
# export DB_URL='jdbc:mysql://localhost:3306/echo?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false'
export DB_USERNAME='echo'
export DB_PASSWORD=''
